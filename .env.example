# ==========================================
# StoryRemix Environment Configuration (.env.example)
# ==========================================

# Supabase Public API (Accessible on client and server)
NEXT_PUBLIC_SUPABASE_URL=https://ysrxzzscfttsiscdpiby.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Legacy anon key alias (supported interchangeably)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative operations, automated round expiration jobs, and moderation overrides
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL (Used for absolute URLs in metadata and share cards)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for authenticating Vercel / external cron invocations
CRON_SECRET=your-secure-random-cron-secret

# Google AdSense (Disabled by default: zero external requests or scripts)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Server-side AI Provider Abstraction (Disabled by default: zero user data sent externally)
AI_PROVIDER_ENABLED=false
AI_PROVIDER_API_KEY=your-private-ai-api-key-here
