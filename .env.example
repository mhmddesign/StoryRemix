# ==========================================
# StoryRemix Environment Configuration
# ==========================================

# Supabase Public API (Accessible on client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative operations, automated round expiration jobs, and moderation overrides
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Application Base URL (Used for absolute URLs in metadata and share cards)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Cron Secret for authenticating Vercel / external cron invocations
CRON_SECRET=your-secure-random-cron-secret
